{
  "name": "open-industrial-collective-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run catalog && vite --host 127.0.0.1",
    "catalog": "npm run schema && tsx scripts/build-catalog.ts",
    "build": "npm run catalog && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run schema && tsx --test tests/*.test.ts",
    "check": "npm test && npm run build && node tests/seo-output.mjs",
    "schema": "node scripts/compile-validator.mjs",
    "profile": "tsx scripts/sync-profile.ts",
    "profile:check": "npm run -s schema && tsx scripts/check-profile.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "ajv": "8.20.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.4",
    "sharp": "^0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
