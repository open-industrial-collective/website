{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openindustrialcollective.org/schemas/project-v1.json",
  "title": "OIC project listing v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "summary",
    "description",
    "category",
    "tags",
    "platforms",
    "source",
    "license",
    "license_url",
    "cost",
    "cost_notes",
    "homepage",
    "get_started",
    "maintainer"
  ],
  "properties": {
    "schema": {
      "const": "oic/project/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 70
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 3000
    },
    "category": {
      "enum": [
        "Data & connectivity",
        "Visualization",
        "Operations",
        "Engineering",
        "AI & automation"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "source": {
      "enum": ["open-source", "source-available", "closed-source"]
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "license_url": {
      "type": "string",
      "format": "https-url"
    },
    "cost": {
      "const": "free"
    },
    "cost_notes": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600
    },
    "homepage": {
      "type": "string",
      "format": "https-url"
    },
    "get_started": {
      "type": "string",
      "format": "https-url"
    },
    "repository": {
      "type": "string",
      "format": "https-url"
    },
    "documentation": {
      "type": "string",
      "format": "https-url"
    },
    "maintainer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "software_requirements": {
      "enum": ["no-paid-required", "paid-platform-required", "see-terms"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "enum": ["open-source", "source-available"]
          }
        }
      },
      "then": {
        "required": ["repository"]
      }
    }
  ]
}
